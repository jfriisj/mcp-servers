keywords = {Text-to-speech synthesis ;  Automatic speech recognition ;  Conversió de text a veu ;  Conversión de texto a voz ;  Machine text-to-text translation ;  Reconeixement automàtic de la parla ;  Reconocimiento automático del habla ;  Speech-to-speech translation ;  Traducció automàtica de la parla ;  Traducció automàtica de textos ;  Traducción automática de textos ;  Traducción automática del habla},
