@article{SAKTISakriani2021NISR,
abstract = {Real-time machine speech translation systems mimic human interpreters and translate incoming speech from a source language to the target language in real-time. Such systems can be achieved by performing low-latency processing in ASR (automatic speech recognition) module before passing the output to MT (machine translation) and TTS (text-to-speech synthesis) modules. Although several studies recently proposed sequence mechanisms for neural incremental ASR (ISR), these frameworks have a more complicated training mechanism than the standard attention-based ASR because they have to decide the incremental step and learn the alignment between speech and text. In this paper, we propose attention-transfer ISR (AT-ISR) that learns the knowledge from attention-based non-incremental ASR for a low delay end-to-end speech recognition. ISR comes with a trade-off between delay and performance, so we investigate how to reduce AT-ISR delay without a significant performance drop. Our experiment shows that AT-ISR achieves a comparable performance to the non-incremental ASR when the incremental recognition begins after the speech utterance reaches 25% of the complete utterance length. Additional experiments to investigate the effect of ISR on translation tasks are also performed. The focus is to find the optimum granularity of the output unit. The results reveal that our end-to-end subword-level ISR resulted in the best translation quality with the lowest WER and the lowest uncovered-word rate.},
author = {SAKTI, Sakriani and NOVITASARI, Sashi and NAKAMURA, Satoshi},
address = {TOKYO},
copyright = {2021 The Institute of Electronics, Information and Communication Engineers},
issn = {0916-8532},
journal = {IEICE Transactions on Information and Systems},
keywords = {Automatic speech recognition ;  Real-time speech translation ;  Attention ;  Attention transfer ;  Computer Science ;  Computer Science Information Systems ;  Computer Science Software Engineering ;  Delay ;  Incremental speech recognition ;  Interpreters ;  Learning transfer ;  Machine translation ;  Modules ;  Real time ;  Science & Technology ;  Speech ;  Speech recognition ;  Speech synthesis ;  Technology ;  Text-to-speech ;  Time ;  Voice recognition},
language = {eng},
number = {12},
pages = {2195-2208},
publisher = {The Institute of Electronics, Information and Communication Engineers},
title = {Neural Incremental Speech Recognition Toward Real-Time Machine Speech Translation},
volume = {E104.D},
year = {2021},
}

@inproceedings{PriyaSSathiya2024CCAC,
abstract = {The rise of social media has firmly established chat as a cornerstone of online interaction. However, language barriers continue to hinder effective communication among users from diverse linguistic backgrounds. Many traditional chat platforms restrict users to a single language, often requiring the use of external translation tools for cross-lingual conversations, a process that can be cumbersome and inefficient. To address this challenge, a groundbreaking chat application designed to shatter language barriers is proposed. By eliminating the need for a shared language, the solution enables seamless communication between individuals from various linguistic backgrounds. Existing chat platforms frequently confine users to one language, necessitating external translation tools for multilingual interactions. It introduces a cutting-edge chat application that seamlessly integrates machine translation into the chat experience, removing the need for additional applications and facilitating unrestricted multilingual communication. To support this vision, an advanced Neural Machine Translation (NMT) model has been developed that effectively addresses the complexities of cross-lingual communication. The model outperforms commercial alternatives such as Google and Bing Translators in terms of BLEU scores (BLEU-1: 0.87 vs. 0.91/0.83; BLEU-2: 0.77 vs. 0.81/0.73), demonstrating superior fluency and accuracy. Additionally, the model achieves a competitive F1 score of 0.87 compared to Google Translator's 0.92, indicating its strong performance in capturing the nuances of translated text. This technological advancement empowers the chat application to deliver seamless and precise multilingual conversations, enabling global connections and enhancing cultural understanding. Through this innovative approach, a future where language serves as a bridge connecting people from all corners of the world, rather than a barrier that divides them, is envisioned.},
author = {Priya, S Sathiya and D, Manivannan and R, Gayathri and K, Manikandann and T, Kujani and S, Bharathi},
address = {NEW YORK},
booktitle = {2024 SECOND INTERNATIONAL CONFERENCE ON INTELLIGENT CYBER PHYSICAL SYSTEMS AND INTERNET OF THINGS, ICOICI 2024},
copyright = {Copyright 2024 Elsevier B.V., All rights reserved.},
isbn = {9798331540661},
keywords = {Automatic Speech Recognition ;  Accuracy ;  Bilingual Evaluation Understudy(BLEU) ;  Computer Science ;  Computer Science Artificial Intelligence ;  Computer Science Cybernetics ;  Computer Science Interdisciplinary Applications ;  Global communication ;  Linguistics ;  Multilingual Communication ;  Neural Machine Translation(NMT) ;  Oral communication ;  Real-time systems ;  Science & Technology ;  Speech recognition ;  Streaming media ;  System performance ;  Technology ;  Text to speech(TTS) ;  User experience ;  Videos},
language = {eng},
organization = {IEEE},
pages = {159-164},
publisher = {IEEE},
title = {Cross-Language Connect: A Chat App for Smooth Multilingual Communication},
year = {2024},
}

@inproceedings{MalageRituV.2023LRST,
abstract = {The introduction of online education has revolutionized the way people acquire knowledge. With resources from top universities like Stanford and MIT, students have access to an immense wealth of educational videos and other material. However, the majority of these resources are in English, creating a language barrier that prevents non-native speakers from utilizing them effectively. In addition, Indic languages have very limited educational resources available online and manual dubbing of videos is time-consuming and labour-intensive. Automated subtitling is not a feasible alternative either, as reading Kannada subtitles alongside English videos can be strenuous. To address these issues, a system is needed that can dub English videos into a specific target language. The focus of this work is on developing such a system for Kannada. The proposed solution is an exhaustive audio-visual system that generates Kannada videos from English videos with accurate lip synchronization, even in dynamic environments, with any kind of face or voice. The system consists of four stages, namely speech-to-text, neural machine translation, text-to-speech, and lip-synchronization. Each component has been evaluated using different metrics, such as Word Error Rate (WER), BiLingual Evaluation Understudy (BLEU) scores, and Mean Opinion Score (MOS), based on surveys conducted to test the output. Extensive quantitative evaluations portray that the naturalness of the lip-synced output video is superior to manually dubbed videos, proved by an overall Mean Opinion Score (MOS) of 4.56. The proposed system has the potential to revolutionize the film industry by replacing the entire manual dubbing process and generating Pan-Global movies. It will also bridge the language gap for people with little or no understanding of English and allow them to access valuable educational resources online in their native language.},
author = {Malage, Ritu V. and Ashish, H. and Hukkeri, Sanjana and Kavya, E. and Jayashree, R.},
address = {Piscataway},
booktitle = {International Conference on Intelligent Computing and Control Systems (Online)},
copyright = {Copyright 2023 Elsevier B.V., All rights reserved.},
isbn = {9798350397253},
issn = {2768-5330},
keywords = {Automatic Speech Recognition ;  Machine translation ;  CAI ;  Colleges & universities ;  Computer assisted instruction ;  Control systems ;  Dubbing ;  Education ;  English language ;  Entertainment industry ;  Indic languages ;  Kannada ;  Lip synchronization ;  Lips ;  Neural Machine Translation ;  Speech recognition ;  Speech synthesis ;  Streaming media ;  Subtitles & subtitling ;  Surveys ;  Synchronism ;  Synchronization ;  Text to Speech ;  Video ;  Voice cloning},
language = {eng},
pages = {1680-1687},
publisher = {IEEE},
title = {Low Resource Speech-to-Speech Translation of English videos to Kannada with Lip-Synchronization},
year = {2023},
}

@inproceedings{ReedyMedarametlaVarshitha2024NLTE,
abstract = {In today's fast-paced global travel landscape, effective communication is crucial, especially in dynamic environments like railway stations. This research paper addresses linguistic diversity challenges by developing a cutting-edge natural language translation engine tailored for railway communication. It integrates advanced technologies such as Transformer-based Automatic Speech Recognition (ASR) with noise reduction algorithms like Wav2Vec 2.0 and an Attention-based Convolutional Recurrent Neural Network (CRNN) to overcome background noise and diverse speech patterns. The system also includes multilingual Text-to-Speech (TTS) and Machine Translation (MT) capabilities for clear communication in real-time across multiple languages. Interactive features like a responsive Chatbot and Interactive Voice Response System (IVRS) enhance user engagement. This approach meets passengers' linguistic needs while promoting inclusivity. Technically, the project explores algorithms like the Transformer model, positional encoding, self-attention mechanisms, and feed-forward neural networks. The research aims to revolutionize railway communication and establish a precedent for technology-driven public transportation, creating universally accessible and user-friendly travel experiences.},
author = {Reedy, Medarametla Varshitha and B, Abdul Naeem and Reddy, Tunga Kartikeya and V, Benedict Vinusha and Pramila, R. Priyanka},
address = {Piscataway},
