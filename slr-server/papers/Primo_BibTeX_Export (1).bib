@inproceedings{GuptaAnchit2021Ivei,
abstract = {This paper proposes a video editor based on OpenShot with several state-of-the-art facial video editing algorithms as added functionalities. Our editor provides an easy-to-use interface to apply modern lip-syncing algorithms interactively. Apart from lip-syncing, the editor also uses audio and facial re-enactment to generate expressive talking faces. The manual control improves the overall experience of video editing without missing out on the benefits of modern synthetic video generation algorithms. This control enables us to lip-sync complex dubbed movie scenes, interviews, television shows, and other visual content. Furthermore, our editor provides features that automatically translate lectures from spoken content, lip-sync of the professor, and background content like slides. While doing so, we also tackle the critical aspect of synchronizing background content with the translated speech. We qualitatively evaluate the usefulness of the proposed editor by conducting human evaluations. Our evaluations show a clear improvement in the efficiency of using human editors and an improved video generation quality.
We attach demo videos with the supplementary material clearly explaining the tool and also showcasing multiple results.},
author = {Gupta, Anchit and Khan, Faizan Farooq and Mukhopadhyay, Rudrabha and Namboodiri, Vinay P. and Jawahar, C. V.},
address = {New York, NY, USA},
booktitle = {Proceedings of the 19th ACM-IEEE International Conference on Formal Methods and Models for System Design},
copyright = {2021 ACM},
isbn = {1450375960},
keywords = {Speech-to-speech translation ;  Computer Science ;  Computer Science Artificial Intelligence ;  Computer Science Software Engineering ;  Computer Science Theory & Methods ;  Computing methodologies -- Artificial intelligence -- Computer vision -- Computer vision problems ;  Human in the loop ;  Imaging Science & Photographic Technology ;  Lip-sync ;  Science & Technology ;  Talking head generation ;  Technology ;  Video editing},
language = {eng},
organization = {ACM},
pages = {1-9},
publisher = {ACM},
title = {Intelligent video editing: incorporating modern talking face generation algorithms in a video editor},
year = {2021},
}

@inproceedings{PingLv2021MPSI,
abstract = {This paper analyzes the function of voice translation software on mobile platform based on the existing technology. To improve the quality of translation, a phrase based translation statistical model is proposed and the training process is analyzed in detail. Then the architecture of the oral translation system is designed by using the speech recognition function of Android framework and the strategy of multi translation engine coordination. For the problem of data sparseness, we adopt a modeling method which combines the language model based on words and the language model with parts of speech. The log linear model is used to analyze the semantic of corpus annotation. The parameters obtained from training reflect the structural information of sentences. Finally, the actual test on the mobile client shows that the real-time speech translation system can not only effectively speed up the speed of data check and audit, but also appropriately improve the accuracy of speech recognition and ensure the quality of translation work.},
author = {Ping, Lv},
address = {LOS ALAMITOS},
booktitle = {International Conference on Measuring Technology and Mechatronics Automation (Print)},
copyright = {Copyright 2021 Elsevier B.V., All rights reserved.},
isbn = {9781665438926},
issn = {2157-1473},
keywords = {Design methodology ;  Analytical models ;  Annotations ;  APP ;  Automation & Control Systems ;  Data models ;  Engineering ;  Engineering Electrical & Electronic ;  Engineering Mechanical ;  Instruments & Instrumentation ;  intelligent recognition ;  JSON ;  log-linear ;  Mechatronics ;  Science & Technology ;  Semantics ;  Sentences ;  Speech recognition ;  Statistical models ;  Technology ;  Training ;  translation ;  Voice recognition},
language = {eng},
