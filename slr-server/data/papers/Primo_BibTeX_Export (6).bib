@article{MingoteVictoria2023DTtS,
abstract = {This letter proposes a direct text to speech translation system using discrete acoustic units. This framework employs text in different source languages as input to generate speech in the target language without the need for text transcriptions in this language. Motivated by the success of acoustic units in previous works for direct speech to speech translation systems, we use the same pipeline to extract the acoustic units using a speech encoder combined with a clustering algorithm. Once units are obtained, an encoder-decoder architecture is trained to predict them. Then a vocoder generates speech from units. Our approach for direct text to speech translation was tested on the new CVSS corpus with two different text mBART models employed as initialisation. The systems presented report competitive performance for most of the language pairs evaluated. Besides, results show a remarkable improvement when initialising our proposed architecture with a model pre-trained with more languages.},
author = {Mingote, Victoria and Gimeno, Pablo and Vicente, Luis and Khurana, Sameer and Laurent, Antoine and Duret, Jarod},
copyright = {Distributed under a Creative Commons Attribution 4.0 International License},
issn = {1070-9908},
journal = {IEEE signal processing letters},
keywords = {Artificial Intelligence ;  Computation and Language ;  Computer Science ;  Machine Learning},
language = {eng},
pages = {1262-1266},
publisher = {Institute of Electrical and Electronics Engineers},
title = {Direct Text to Speech Translation System Using Acoustic Units},
volume = {30},
year = {2023},
}

