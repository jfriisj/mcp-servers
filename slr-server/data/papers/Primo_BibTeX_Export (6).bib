@article{InagumaHirofumi2021EI2O,
abstract = {This paper describes the ESPnet-ST group's IWSLT 2021 submission in the offline speech translation track. This year we made various efforts on training data, architecture, and audio segmentation. On the data side, we investigated sequence-level knowledge distillation (SeqKD) for end-to-end (E2E) speech translation. Specifically, we used multi-referenced SeqKD from multiple teachers trained on different amounts of bitext. On the architecture side, we adopted the Conformer encoder and the Multi-Decoder architecture, which equips dedicated decoders for speech recognition and translation tasks in a unified encoder-decoder model and enables search in both source and target language spaces during inference. We also significantly improved audio segmentation by using the pyannote.audio toolkit and merging multiple short segments for long context modeling. Experimental evaluations showed that each of them contributed to large improvements in translation performance. Our best E2E system combined all the above techniques with model ensembling and achieved 31.4 BLEU on the 2-ref of tst2021 and 21.2 BLEU and 19.3 BLEU on the two single references of tst2021.},
author = {Inaguma, Hirofumi and Yan, Brian and Dalmia, Siddharth and Guo, Pengcheng and Shi, Jiatong and Duh, Kevin and Watanabe, Shinji},
address = {Ithaca},
copyright = {2021. This work is published under http://arxiv.org/licenses/nonexclusive-distrib/1.0/ (the “License”). Notwithstanding the ProQuest Terms and Conditions, you may use this content in accordance with the terms of the License.},
issn = {2331-8422},
journal = {arXiv.org},
keywords = {Audio data ;  Coders ;  Distillation ;  Encoders-Decoders ;  Segmentation ;  Speech recognition},
language = {eng},
publisher = {Cornell University Library, arXiv.org},
title = {ESPnet-ST IWSLT 2021 Offline Speech Translation System},
year = {2021},
}

@inproceedings{XuZhe-Jia2024MSTf,
abstract = {The speaking at cross purposes is one of the common problems in elderly care scenarios, especially the cross-language conversation in medical consultations. Constructing a multilingual speech translation service for medical consultation can improve the efficiency of cross-language conversations. This study focuses on proposed a multilingual speech translator for Chinese, Indonesian and Taiwanese processing. In this paper, an under-resourced Taiwanese ASR model was constructed by the collected Tailuo pinyin dataset. The experimental results show the proposed Taiwanese ASR model achieved good performance on Taiwanese speech recognition. Furthermore, the Taiwanese ASR model and Indonesian ASR model are integrated into a speech translation system to construct a speech-to-speech translator for medical consultation tasks. The proposed multilingual speech translator demonstrated the practicality and functionality for auxiliary application tasks such as cross-language conversation.},
author = {Xu, Zhe-Jia and Chen, Yeou-Jiunn and Hong, Qian-Bei},
booktitle = {2024 27th Conference on the Oriental COCOSDA International Committee for the Co-Ordination and Standardisation of Speech Databases and Assessment Techniques, O-COCOSDA 2024 - Proceedings},
copyright = {Copyright 2025 Elsevier B.V., All rights reserved.},
isbn = {9798331506032},
issn = {2472-7695},
keywords = {end-to-end architecture ;  Medical services ;  Multilingual ;  Noise measurement ;  Older adults ;  Oral communication ;  Speech processing ;  Speech recognition ;  Speech translator ;  Tailuo pinyin ;  Translation},
language = {eng},
pages = {1-5},
publisher = {IEEE},
title = {Multilingual Speech Translator for Medical Consultation},
year = {2024},
}

