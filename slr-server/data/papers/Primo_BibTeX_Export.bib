@article{MingoteVictoria2023DTtS,
abstract = {This paper proposes a direct text to speech translation system using discrete acoustic units. This framework employs text in different source languages as input to generate speech in the target language without the need for text transcriptions in this language. Motivated by the success of acoustic units in previous works for direct speech to speech translation systems, we use the same pipeline to extract the acoustic units using a speech encoder combined with a clustering algorithm. Once units are obtained, an encoder-decoder architecture is trained to predict them. Then a vocoder generates speech from units. Our approach for direct text to speech translation was tested on the new CVSS corpus with two different text mBART models employed as initialisation. The systems presented report competitive performance for most of the language pairs evaluated. Besides, results show a remarkable improvement when initialising our proposed architecture with a model pre-trained with more languages.},
author = {Mingote, Victoria and Gimeno, Pablo and Vicente, Luis and Khurana, Sameer and Laurent, Antoine and Duret, Jarod},
address = {New York},
copyright = {Copyright The Institute of Electrical and Electronics Engineers, Inc. (IEEE) 2023},
issn = {1070-9908},
journal = {IEEE signal processing letters},
keywords = {Acoustic units ;  Acoustics ;  Algorithms ;  Clustering ;  Coders ;  Computer architecture ;  CVSS corpus ;  direct text to speech translation ;  Encoders-Decoders ;  Languages ;  Machine translation ;  mBART ;  Spectrogram ;  Speech encoders ;  Speech recognition ;  Task analysis ;  Training ;  Vocoders},
language = {eng},
pages = {1-5},
publisher = {IEEE},
title = {Direct Text to Speech Translation System Using Acoustic Units},
volume = {30},
year = {2023},
}

@inproceedings{PolakPeter2024LEST,
abstract = {Contemporary datasets provide an oracle segmentation into sentences based on human-annotated transcripts and translations. However, the segmentation into sentences is not available in the real world. Current speech segmentation approaches offer poor segmentation quality in the low-latency regime. This paper proposes a novel segmentation approach for a low-latency end-to-end speech translation. We leverage an existing speech translation encoder-decoder architecture with speech translation CTC (ST CTC) and show that the latent alignments produced by ST CTC can guide the segmentation. To the best of our knowledge, our method is the first that allows an actual long-form end-to-end simultaneous speech translation, as one neural model translates and segments simultaneously. On a diverse set of language pairs and in- and out-of-domain data, we show that the proposed approach outperforms current state-of-the-art segmentation methods at no additional computational cost.},
author = {Polak, Peter and Bojar, Ondrej},
booktitle = {2024 IEEE Spoken Language Technology Workshop (SLT)},
isbn = {9798350392258},
keywords = {Computational efficiency ;  Computational modeling ;  Computer architecture ;  Conferences ;  latent alignment ;  long-form ;  Low latency communication ;  segmentation ;  simultaneous ;  speech translation ;  Translation},
language = {eng},
pages = {1076-1082},
publisher = {IEEE},
title = {Long-Form End-To-End Speech Translation VIA Latent Alignment Segmentation},
year = {2024},
}

@inproceedings{LeeAnn2022DSTW,
abstract = {We present a direct speech-to-speech translation (S2ST) model that translates speech from one language to speech in another language without relying on intermediate text generation. We tackle the problem by first applying a self-supervised discrete speech encoder on the target speech and then training a sequence-to-sequence speech-to-unit translation (S2UT) model to predict the discrete representations of the target speech. When target text transcripts are available, we design a joint speech and text training framework that enables the model to generate dual modality output (speech and text) simultaneously in the same inference pass. Experiments on the Fisher Spanish-English dataset show that the proposed framework yields improvement of 6.7 BLEU compared with a baseline direct S2ST model that predicts spectrogram features. When trained without any text transcripts, our model performance is comparable to models that predict spectrograms and are trained with text supervision, showing the potential of our system for translation between unwritten languages(1).},
author = {Lee, Ann and Chen, Peng-Jen and Wang, Changhan and Gu, Jiatao and Popuri, Sravya and Ma, Xutai and Polyak, Adam and Adi, Yossi and He, Qing and Tang, Yun and Pino, Juan and Hsu, Wei-Ning},
address = {STROUDSBURG},
booktitle = {PROCEEDINGS OF THE 60TH ANNUAL MEETING OF THE ASSOCIATION FOR COMPUTATIONAL LINGUISTICS (ACL 2022), VOL 1: (LONG PAPERS)},
isbn = {9781955917216},
keywords = {Computer Science ;  Computer Science Artificial Intelligence ;  Computer Science Interdisciplinary Applications ;  Linguistics ;  Science & Technology ;  Social Sciences ;  Technology},
language = {eng},
organization = {Assoc Computat Linguist},
pages = {3327-3339},
publisher = {Assoc Computational Linguistics-Acl},
title = {Direct Speech-to-Speech Translation With Discrete Units},
year = {2022},
}

