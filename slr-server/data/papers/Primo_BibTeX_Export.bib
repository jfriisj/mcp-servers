isbn = {9798350328202},
keywords = {Automatic speech recognition ;  Automatic Speech Recognition (ASR) ;  Algorithms ;  Ambient noise ;  Background noise ;  Chatbot ;  Chatbots ;  Communication ;  Convolutional Recurrent Neural Network (CRNN) ;  Engines ;  Information technology ;  Interactive systems ;  IVRS ;  Language translation ;  Linguistics ;  Machine translation ;  Natural language ;  Natural language processing ;  Natural Translation Engine ;  Neural networks ;  Noise reduction ;  Public transportation ;  Railroads ;  Railway communication ;  Railway stations ;  Real-time systems ;  Recurrent neural networks ;  Text-to-Speech model (TTS) ;  Transformation- based model ;  Transformers ;  Voice communication ;  Wave2Vec},
language = {eng},
pages = {1-9},
publisher = {IEEE},
title = {Natural Language Translation Engine For Announcements and Information Dissemination At Stations},
year = {2024},
}

@inproceedings{PrasadAman2025DaRS,
abstract = {The development of this automatic speech-to-speech translation system is intended to eliminate language barriers encouraging smooth interaction in a multilingual setting. This can be done through three major processes, automatic speech recognition (ASR), machine translation (MT), and speech synthesis, which are seamlessly integrated to provide prompt translations using a simple interface. The system contains twelve languages including but not limited to English, Hindi, Japanese, Tamil, French, and Spanish. It captures the essence of the source language while reproducing it in the target language, speech input is first transcribed and translated before being synthesized in the target language. Users can listen to audio output while following along with the text visualization which optimizes understanding and ease of use. The translation system is specially made for fast-paced environments like tourism, business meetings, and live events due to its immediate processing capabilities. Users can add more languages in the future thanks to the modular custom design as well as make changes to dialects. This technology facilitates interaction between people who speak different languages enhancing global unity.},
