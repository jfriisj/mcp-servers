@inproceedings{ArabyYoussef2025RLwA,
abstract = {Language barriers significantly hinder global communication, affecting accessibility, business, education, and entertainment. While digital interactions increasingly replace face-to-face communication, real-time video translation has emerged as a critical solution, integrating speech recognition, natural language processing, speech synthesis, and computer vision to enable seamless cross-lingual dialogue. However, existing systems face key limitations, including high end-to-end latency and insufficient support for under-resourced languages such as Arabic, particularly in lip-synchronized expressive speech synthesis. This paper presents a modular pipeline architecture designed to optimize real-time video translation by combining state-of-the-art AI models for automatic speech recognition (ASR), machine translation (MT), text-to-speech synthesis (TTS), and lip synchronization. The proposed system achieves a word error rate (WER) of 5−7% in ASR, a machine translation BLEU score of 0.06, and high-quality text-to-speech synthesis with strong voice cloning capabilities. The lip synchronization module ensures precise alignment, reaching a SyncNet distance of 7.19 (LSE D) and 6.87 (LSE C). Additionally, the system operates with low latency, maintaining < 150ms for lip-syncing and 29.8s per hour for ASR processing. We conduct a comprehensive benchmarking of models for each component, prioritizing low-latency operation without compromising translation quality. The proposed approach enhances accessibility, fosters intercultural communication, and establishes a scalable framework for future multilingual video translation technologies.},
author = {Araby, Youssef and Hebishy, Rodaina and Mohammed, Ammar},
booktitle = {2025 Intelligent Methods, Systems, and Applications​ (IMSA)},
isbn = {9798331501860},
keywords = {Machine translation ;  AI Voice Cloning ;  Arabic Language ;  Cloning ;  Lip Sync ;  Lips ;  Low latency communication ;  Multilingual ;  Multilingual Video Processing ;  Real-time systems ;  Real-Time Translation ;  Synchronization ;  Text to speech ;  Translation ;  Videos},
language = {eng},
pages = {346-351},
publisher = {IEEE},
title = {Real-Time Lip-Sync with AI-Driven Voice Cloning Technology},
year = {2025},
}

@inproceedings{MaithaniHimanshu2024IiRS,
abstract = {At present, speech-to-speech translator systems often involve multiple intermediary steps, such as automatic speech recognition (ASR), text-to-text machine translation (MT), and text-to-speech generation (TTS), leading to latency in response time and error propagation to later stages. Furthermore, they face challenges when dealing with languages lacking text representation. This paper examines the feasibility of a direct speech-to-speech translator model trained without the use of intermediate text representations during both training and inference. Employing the Librosa library for feature extraction, our approach uses Mel-frequency cepstral coefficients (MFCCs) in conjunction with a sequence-to-sequence Recurrent Neural Network (RNN) model for training on a dataset of German-to-English audio. Our model achieved a BLEU score of 23.5, demonstrating competitive performance. The Perceptual Evaluation of Speech Quality (PESQ) score of 2.9 reveals high-quality generated speech. The average time delay for translation is {1. 5} seconds, significantly lower than the 2.5 to 3 seconds observed in traditional cascade models. Our experiments, including noise-free speech generation using the Griffin Lim algorithm, underline the potential of our approach for real-time applications and lay a promising foundation for future research.},
author = {Maithani, Himanshu and Goswami, Aditya Giri and Anita, R and Dorathi Jayaseeli, J D and Tiwari, Sourabh and Shankarappa, Rashmi T},
booktitle = {2024 15th International Conference on Computing Communication and Networking Technologies, ICCCNT 2024},
copyright = {Copyright 2024 Elsevier B.V., All rights reserved.},
isbn = {9798350370249},
issn = {2473-7674},
keywords = {Real-time systems ;  Accuracy ;  BLEU score assessment ;  Computational modeling ;  Computer architecture ;  Context modeling ;  Libraries ;  Librosa library ;  Mel frequency cepstral coefficient ;  Mel-frequency cepstral coefficients (MFCCs) ;  Perceptual Evaluation of Speech Quality ;  Sequence-to-sequence RNN model ;  Speech processing ;  Speech-to-speech translator ;  Text to speech ;  Training},
language = {eng},
