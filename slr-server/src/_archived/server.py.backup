@app.call_tool()
async def call_tool(name: str, arguments: Dict[str, Any]) -> Sequence[types.TextContent]:
    """Handle MCP tool calls."""
    if handler is None:
        return [types.TextContent(
            type="text",
            text='{"success": false, "error": "Server not initialized", "error_type": "system"}'
        )]
    
    try:
        result = None
        
        # Paper Management Tools
        if name == "upload-paper":
            result = await handler.handle_upload_paper(arguments)
        elif name == "upload-paper-with-full-text":
            result = await handler.handle_upload_paper_with_full_text(arguments)
        elif name == "upload-bibliography-batch":
            result = await handler.handle_upload_bibliography_batch(arguments)
        elif name == "get-paper":
            result = await handler.handle_get_paper(arguments)
        elif name == "list-papers":
            result = await handler.handle_list_papers(arguments)
        elif name == "search-papers":
            result = await handler.handle_search_papers(arguments)
        
        # Quality Assessment Tools
        elif name == "assess-quality":
            result = await handler.handle_assess_quality(arguments)
        elif name == "get-quality-assessment":
            result = await handler.handle_get_quality_assessment(arguments)
        
        # Citation & Structure Tools
        elif name == "analyze-citations":
            result = await handler.handle_analyze_citations(arguments)
        elif name == "get-paper-structure":
            result = await handler.handle_get_paper_structure(arguments)
        
        # Research Validation & Evidence Tools
        elif name == "validate-research-question":
            result = await handler.validate_research_question(arguments)
        elif name == "synthesize-evidence":
            result = await handler.handle_synthesize_evidence(arguments)
        
        # Indexing & Report Tools
        elif name == "index-paper":
            result = await handler.handle_index_paper(arguments)
        elif name == "generate-slr-report":
            result = await handler.handle_generate_slr_report(arguments)
        
        # Maintenance Tools
        elif name == "detect-remove-duplicates":
            result = await handler.handle_detect_remove_duplicates(arguments)
        
        # Workflow & Project Management Tools
        elif name == "create-slr-project":
            result = await handler.workflow_handler.handle_create_slr_project(arguments)
        elif name == "get-slr-progress":
            result = await handler.workflow_handler.handle_get_slr_progress(arguments)
        elif name == "get-next-steps":
            result = await handler.workflow_handler.handle_get_next_steps(arguments)
        elif name == "create-screening-workflow":
            result = await handler.workflow_handler.handle_create_screening_workflow(arguments)
        elif name == "screen-paper":
            result = await handler.workflow_handler.handle_screen_paper(arguments)
        elif name == "get-slr-guide":
            result = await handler.workflow_handler.handle_get_slr_guide(arguments)
        
        # Note: test-hypothesis tool defined but handler not yet implemented
        elif name == "test-hypothesis":
            return [types.TextContent(
                type="text",
                text="❌ test-hypothesis handler not yet implemented"
            )]
        
        else:
            return [types.TextContent(
                type="text",
                text=f"Unknown tool: {name}"
            )]
        
        # Convert CallToolResult to TextContent list
        if result is not None:
            if hasattr(result, 'content') and result.content:
                # Return content from CallToolResult (should be list of TextContent)
                return list(result.content)  # type: ignore
            elif isinstance(result, dict):
                import json
                return [types.TextContent(
                    type="text",
                    text=json.dumps(result, ensure_ascii=False, indent=2)
                )]
        
        return [types.TextContent(type="text", text="No result")]
    
    except Exception as e:
        logger.error(f"Tool execution error for {name}: {str(e)}")
        return [types.TextContent(
            type="text", 
            text=f"Error: {str(e)}"
        )]


async def main():
    """Run the SLR MCP server."""
    initialize_dependencies()
    async with stdio_server() as (read_stream, write_stream):
        logger.info("Starting SLR MCP Server...")
        await app.run(read_stream, write_stream, app.create_initialization_options())


if __name__ == "__main__":
    import asyncio
    asyncio.run(main())