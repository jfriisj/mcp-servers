{
  "servers": {
    "slr-server": {
      "command": "python",
      "args": ["start_server.py"],
      "cwd": "C:/github/mcp-servers/slr-server",
      "env": {
        "DATABASE_PATH": "C:/github/mcp-servers/slr-server/slr_production.db",
        "LOG_LEVEL": "INFO",
        "MAX_PAPERS_PER_ANALYSIS": "100",
        "ENABLE_CACHING": "true"
      }
    },
    "slr-server-docker": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--name",
        "mcp-slr-server-${workspaceFolderBasename}",
        "-v",
        "${workspaceFolder}:/workspace",
        "-v",
        "${workspaceFolder}/slr-server/data:/app/data",
        "-e",
        "DATABASE_PATH=/app/data/slr_production.db",
        "slr-server-slr-server:latest"
      ]
    }
  },
  "tools": {
    "upload-paper": {
      "description": "Upload and process academic papers for systematic review analysis",
      "examples": [
        {
          "name": "Upload healthcare ML paper",
          "parameters": {
            "file_path": "./papers/ml_healthcare_2023.pdf",
            "title": "Machine Learning in Healthcare: A Systematic Review",
            "tags": ["machine-learning", "healthcare", "systematic-review"]
          }
        }
      ]
    },
    "assess-quality": {
      "description": "Evaluate paper quality using systematic assessment frameworks",
      "examples": [
        {
          "name": "PRISMA quality assessment",
          "parameters": {
            "paper_id": 1,
            "framework": "prisma",
            "reviewer_id": "researcher_001"
          }
        }
      ]
    },
    "validate-research-question": {
      "description": "Validate research questions using PICO/SPIDER frameworks",
      "examples": [
        {
          "name": "PICO validation example",
          "parameters": {
            "question_text": "How effective are machine learning algorithms in improving diagnostic accuracy in healthcare compared to traditional methods?",
            "framework": "pico",
            "suggest_improvements": true
          }
        }
      ]
    },
    "analyze-citations": {
      "description": "Perform citation network analysis on research papers",
      "examples": [
        {
          "name": "Citation network analysis",
          "parameters": {
            "paper_id": 1,
            "include_network": true,
            "depth": 2
          }
        }
      ]
    },
    "analyze-hypothesis": {
      "description": "Extract and analyze hypotheses with evidence synthesis",
      "examples": [
        {
          "name": "Meta-analysis of ML effectiveness",
          "parameters": {
            "paper_ids": [1, 2, 3],
            "hypothesis_text": "Machine learning algorithms demonstrate significantly higher diagnostic accuracy than traditional methods",
            "meta_analysis": true
          }
        }
      ]
    },
    "index-paper": {
      "description": "Create intelligent academic chunks and indexes for papers",
      "examples": [
        {
          "name": "Academic section chunking",
          "parameters": {
            "paper_id": 1,
            "strategy": "academic-section",
            "optimize_for_agents": true
          }
        }
      ]
    },
    "synthesize-evidence": {
      "description": "Generate evidence synthesis and recommendations",
      "examples": [
        {
          "name": "Complete evidence synthesis",
          "parameters": {
            "research_question_id": 1,
            "paper_ids": [1, 2, 3, 4, 5],
            "include_meta_analysis": true,
            "include_grade_assessment": true
          }
        }
      ]
    }
  },
  "settings": {
    "auto_connect": true,
    "reconnect_on_error": true,
    "timeout_seconds": 30,
    "debug_mode": false
  }
}