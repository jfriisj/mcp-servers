{
  "servers": {
    "spec-workflow": {
      "command": "npx",
      "args": ["-y", "@pimzino/spec-workflow-mcp@latest", "."],
      "cwd": "${workspaceFolder}"
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "whisper": {
      "command": "python",
      "args": [
        "src/main.py"
      ],
      "cwd": "${workspaceFolder}/whisper-server",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/whisper-server/src",
        "HUGGINGFACE_TOKEN": "${HUGGINGFACE_TOKEN}",
        "HF_TOKEN": "${HF_TOKEN}",
        "USE_GPU": "true",
        "ENABLE_PARALLEL_PROCESSING": "true",
        "MAX_CONCURRENT_TRANSCRIPTIONS": "3"
      }
    },    
    "whisper-docker-cpu": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--name",
        "whisper-mcp-cpu",
        "-v",
        "${workspaceFolder}:/workspace",
        "-e",
        "HUGGINGFACE_TOKEN=${HUGGINGFACE_TOKEN}",
        "-e",
        "HF_TOKEN=${HF_TOKEN}",
        "-e",
        "USE_GPU=false",
        "-e",
        "ENABLE_PARALLEL_PROCESSING=false",
        "-e",
        "MAX_CONCURRENT_TRANSCRIPTIONS=1",
        "ghcr.io/jfriisj/whisper-mcp-server-cpu:latest"
      ]
    },
    "multi-lint-docker": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--name",
        "mcp-docker-lint-mcp",
        "-v",
        "${workspaceFolder}:/workspace",
        "ghcr.io/jfriisj/multi-lint-docker:latest"
      ]
    },
    "multi-lint-infrastructure": {
      "command": "docker", 
      "args": [
        "run",
        "--rm", 
        "-i",
        "--name",
        "mcp-infrastructure-lint-mcp",
        "-v",
        "${workspaceFolder}:/workspace",
        "ghcr.io/jfriisj/multi-lint-infrastructure:latest"
      ]
    },
    "multi-lint-python": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--name",
        "mcp-python-lint-mcp",
        "-v", 
        "${workspaceFolder}:/workspace",
        "ghcr.io/jfriisj/multi-lint-python:latest"
      ]
    },
    "import-analysis": {
      "command": "python",
      "args": [
        "import-analysis-server/src/main.py",
        "--project-root",
        "${workspaceFolder}"
      ],
      "cwd": "C:/github/mcp-servers",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    "import-analysis-docker": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--name",
        "mcp-import-analysis-${workspaceFolderBasename}",
        "-v",
        "${workspaceFolder}:/workspace",
        "ghcr.io/jfriisj/import-analysis-mcp-server:latest"
      ]
    },
    "solid-docker": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--name",
        "mcp-solid-${workspaceFolderBasename}",
        "-v",
        "${workspaceFolder}:/workspace",
        "ghcr.io/jfriisj/solid-mcp-server:latest"
      ]
    }
  }
}