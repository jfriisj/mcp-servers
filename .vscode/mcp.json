{
  "servers": {
    "spec-workflow": {
      "command": "npx",
      "args": ["-y", "@pimzino/spec-workflow-mcp@latest", "."],
      "cwd": "${workspaceFolder}"
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "whisper": {
      "command": "python",
      "args": [
        "src/main.py"
      ],
      "cwd": "${workspaceFolder}/whisper-server",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/whisper-server/src"
      }
    },
    "multi-lint-docker": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--name",
        "mcp-docker-lint-mcp",
        "-v",
        "${workspaceFolder}:/workspace",
        "ghcr.io/jfriisj/multi-lint-docker:latest"
      ]
    },
    "multi-lint-infrastructure": {
      "command": "docker", 
      "args": [
        "run",
        "--rm", 
        "-i",
        "--name",
        "mcp-infrastructure-lint-mcp",
        "-v",
        "${workspaceFolder}:/workspace",
        "ghcr.io/jfriisj/multi-lint-infrastructure:latest"
      ]
    },
    "multi-lint-python": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--name",
        "mcp-python-lint-mcp",
        "-v", 
        "${workspaceFolder}:/workspace",
        "ghcr.io/jfriisj/multi-lint-python:latest"
      ]
    },
    "import-test-docker": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--name",
        "mcp-import-test-${workspaceFolderBasename}",
        "-v",
        "${workspaceFolder}:/workspace",
        "ghcr.io/jfriisj/import-test-mcp-server:latest"
      ]
    },
    "solid-docker": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--name",
        "mcp-solid-${workspaceFolderBasename}",
        "-v",
        "${workspaceFolder}:/workspace",
        "ghcr.io/jfriisj/solid-mcp-server:latest"
      ]
    }
  }
}