{
  "servers": {
    "spec-workflow": {
      "command": "npx",
      "args": ["-y", "@pimzino/spec-workflow-mcp@latest", "."],
      "cwd": "${workspaceFolder}"
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    }, 
    "whisper-docker-cpu": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--name",
        "whisper-mcp-cpu",
        "-v",
        "${workspaceFolder}:/workspace",
        "-e",
        "HUGGINGFACE_TOKEN=${HUGGINGFACE_TOKEN}",
        "-e",
        "HF_TOKEN=${HF_TOKEN}",
        "-e",
        "USE_GPU=false",
        "-e",
        "ENABLE_PARALLEL_PROCESSING=false",
        "-e",
        "MAX_CONCURRENT_TRANSCRIPTIONS=1",
        "ghcr.io/jfriisj/whisper-mcp-server-cpu:latest"
      ]
    },
    "multi-lint-docker": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--name",
        "mcp-docker-lint-mcp",
        "-v",
        "${workspaceFolder}:/workspace",
        "ghcr.io/jfriisj/multi-lint-docker:latest"
      ]
    },
    "multi-lint-infrastructure": {
      "command": "docker", 
      "args": [
        "run",
        "--rm", 
        "-i",
        "--name",
        "mcp-infrastructure-lint-mcp",
        "-v",
        "${workspaceFolder}:/workspace",
        "ghcr.io/jfriisj/multi-lint-infrastructure:latest"
      ]
    },
    "multi-lint-python": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--name",
        "mcp-python-lint-mcp",
        "-v", 
        "${workspaceFolder}:/workspace",
        "ghcr.io/jfriisj/multi-lint-python:latest"
      ]
    },
    "import-analysis-docker": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--name",
        "mcp-import-analysis-${workspaceFolderBasename}",
        "-v",
        "${workspaceFolder}:/workspace",
        "ghcr.io/jfriisj/import-analysis-mcp-server:latest"
      ]
    },
    "solid": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--name",
        "mcp-solid-${workspaceFolderBasename}",
        "-v",
        "${workspaceFolder}:/workspace",
        "ghcr.io/jfriisj/solid-mcp-server:latest"
      ]
    },
    "study-buddy": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--name",
        "mcp-study-buddy-${workspaceFolderBasename}",
        "-v",
        "${workspaceFolder}:/workspace",
        "-v",
        "${workspaceFolder}/study_buddy/data:/app/data",
        "-e",
        "STUDY_BUDDY_DB_PATH=/app/data/study_buddy.db",
        "ghcr.io/jfriisj/study-buddy-mcp-server:latest"
      ]
    },
    "slr-server": {
      "command": "python",
      "args": ["start_server.py"],
      "cwd": "${workspaceFolder}/slr-server",
      "env": {
        "DATABASE_PATH": "${workspaceFolder}/slr-server/database/slr_database.db",
        "PROJECT_ROOT": "${workspaceFolder}/slr-server",
        "LOG_LEVEL": "INFO",
        "MAX_PAPERS_PER_ANALYSIS": "100",
        "ENABLE_CACHING": "true"
      }
    },
    "slr-server-docker": {
      "command": "docker",
      "args": [
        "run", "-i", "--rm",
        "--network", "deployment_slr-network",
        "-v", "C:/github/mcp-servers/slr-server/deployment/papers:/app/papers:ro",
        "-e", "DATABASE_TYPE=postgresql",
        "-e", "POSTGRES_HOST=slr-postgres",
        "-e", "POSTGRES_PORT=5432", 
        "-e", "POSTGRES_DB=slr_database",
        "-e", "POSTGRES_USER=slr_user",
        "-e", "POSTGRES_PASSWORD=slr_password",
        "-e", "LOG_LEVEL=INFO",
        "-e", "MAX_PAPERS_PER_ANALYSIS=100",
        "slr-mcp-server:latest",
        "python", "-m", "src.main"
      ]
    }
  }
}